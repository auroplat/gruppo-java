package it.unipv.bitFactory.prenotazioni;

public class Cliente {

    private String nome;
    private String cognome;
    private boolean patenteValida;
    private int eta;
    private String telefono;
    private String email;

    public Cliente(String nome,
                   String cognome,
                   boolean patenteValida,
                   int eta,
                   String telefono,
                   String email) {

        this.nome = nome;
        this.cognome = cognome;
        this.patenteValida = patenteValida;
        this.eta = eta;
        this.telefono = telefono;
        this.email = email;
    }

    public String getNome() {
        return nome;
    }

    public String getCognome() {
        return cognome;
    }

    public boolean isPatenteValida() {
        return patenteValida;
    }

    public int getEta() {
        return eta;
    }

    public String getTelefono() {
        return telefono;
    }

    public String getEmail() {
        return email;
    }

    @Override
    public String toString() {

        return nome + " " + cognome +
                " | Patente valida: " + patenteValida +
                " | Eta: " + eta +
                " | Telefono: " + telefono +
                " | Email: " + email;
    }
}
