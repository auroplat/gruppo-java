package it.unipv.bitFactory.prenotazioni;

import java.util.Scanner;

public class Cliente {

    private String nome;
    private String cognome;
    private boolean patenteValida;
    private int eta;
    private String telefono;
    private String email;

    public Cliente(String nome,
                   String cognome,
                   boolean patenteValida,
                   int eta,
                   String telefono,
                   String email) {

        this.nome = nome;
        this.cognome = cognome;
        this.patenteValida = patenteValida;
        this.eta = eta;
        this.telefono = telefono;
        this.email = email;
    }

    //Inserimento dei dati del cliente 

    public static Cliente daTastiera() {

        Scanner sc = new Scanner(System.in);

        System.out.print("Inserisci nome: ");
        String nome = sc.nextLine();

        System.out.print("Inserisci cognome: ");
        String cognome = sc.nextLine();

        //Validità patente

        boolean patenteValida;

        while (true) {
            System.out.print("Hai la patente valida? (si/no): ");
            String risposta = sc.nextLine().trim().toLowerCase();

            if (risposta.equals("si")) {
                patenteValida = true;
                break;
            } else if (risposta.equals("no")) {
                patenteValida = false;
                break;
            } else {
                System.out.println("Risposta non valida, scrivi 'si' o 'no'.");
            }
        }

        System.out.print("Inserisci età: ");
        int eta = Integer.parseInt(sc.nextLine());

        System.out.print("Inserisci telefono: ");
        String telefono = sc.nextLine();

        System.out.print("Inserisci email: ");
        String email = sc.nextLine();

        return new Cliente(nome, cognome, patenteValida, eta, telefono, email);
    }

    public String getNome() {
        return nome;
    }

    public String getCognome() {
        return cognome;
    }

    public boolean isPatenteValida() {
        return patenteValida;
    }

    public int getEta() {
        return eta;
    }

    public String getTelefono() {
        return telefono;
    }

    public String getEmail() {
        return email;
    }

    @Override
    public String toString() {
        return nome + " " + cognome +
                " | Patente valida: " + patenteValida +
                " | Eta: " + eta +
                " | Telefono: " + telefono +
                " | Email: " + email;
    }
}
