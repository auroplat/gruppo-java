//Non anocra testato, solo concettuale 

package it.unipv.bitFactory.prenotazioni;

import it.unipv.bitFactory.veicoli.Legends;

import java.util.ArrayList;
import java.util.List;
import java.util.Scanner;

public class MainTest {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        GestoreEventi gestoreInterno = new GestoreEventi();
        gestoreInterno.caricaEventiDaCSV("eventi.csv");

        List<Evento> eventiInterni = gestoreInterno.getEventi();

        GestoreEventiEsterni gestoreEsterni = new GestoreEventiEsterni();
        gestoreEsterni.caricaEventiDaCSVEsterno("eventi_esterni.csv");

        List<Evento> eventiEsterni = gestoreEsterni.getEventi();

        List<Evento> tuttiEventi = new ArrayList<>();

        tuttiEventi.addAll(eventiInterni);
        tuttiEventi.addAll(eventiEsterni);

        List<Evento> eventiDisponibili = new ArrayList<>();

        for (Evento e : tuttiEventi) {
            if (e.getPostiDisponibili() > 0) {
                eventiDisponibili.add(e);
            }
        }

        System.out.println("=== EVENTI DISPONIBILI ===");

        for (int i = 0; i < eventiDisponibili.size(); i++) {

            Evento e = eventiDisponibili.get(i);

            System.out.println(
                    (i + 1) + " - " +
                    e.getNomeEvento() +
                    " | Data: " + e.getDataEvento() +
                    " | Posti: " + e.getPostiDisponibili()
            );
        }

        System.out.print("\nScegli evento: ");

        int scelta = Integer.parseInt(sc.nextLine());

        Evento eventoScelto = eventiDisponibili.get(scelta - 1);

        System.out.println("\nHai scelto: " + eventoScelto.getNomeEvento());

        Legends auto = new Legends();

        System.out.println("\n=== INSERIMENTO DATI CLIENTE ===");

        Cliente cliente = Cliente.daTastiera();

        SistemaPrenotazioni sistema = new SistemaPrenotazioni();

        System.out.println("\n=== PRENOTAZIONE IN CORSO ===");

        sistema.effettuaPrenotazione(cliente, eventoScelto, auto);

        System.out.println("\n=== PRENOTAZIONI REGISTRATE ===");

        GestorePrenotazioni.getInstance().mostraPrenotazioni();

        sc.close();
    }
}
