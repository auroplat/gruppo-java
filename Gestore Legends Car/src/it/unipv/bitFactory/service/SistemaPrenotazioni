package it.unipv.bitFactory.prenotazioni;

import it.unipv.bitFactory.veicoli.Legends;

public class SistemaPrenotazioni {

    public String effettuaPrenotazione(Cliente cliente,
                                       Evento evento,
                                       Legends auto) {

        if (cliente.getEta() < 18) {
            return "Il cliente deve essere maggiorenne.";
        }

        if (!cliente.isPatenteValida()) {
            return "Il cliente non possiede una patente valida.";
        }

        if (evento.getPostiDisponibili() <= 0) {
            return "Prenotazione non possibile: nessun posto disponibile.";
        }

        Prenotazione prenotazione =
                new Prenotazione(
                        cliente.getNome(),
                        evento.getNomeEvento(),
                        auto
                );

        GestorePrenotazioni.getInstance()
                .aggiungiPrenotazione(prenotazione);

        evento.diminuisciPosti();

        SistemaNotifiche notifiche = new SistemaNotifiche();
        notifiche.inviaConferma(cliente, evento);

        return "Prenotazione completata con successo.";
    }

    public String annullaPrenotazione(Cliente cliente,
                                      Evento evento) {

        Prenotazione prenotazione =
                GestorePrenotazioni.getInstance()
                        .cercaPrenotazione(
                                cliente.getNome(),
                                evento.getNomeEvento());

        if (prenotazione == null) {
            return "Prenotazione non trovata.";
        }

        GestorePrenotazioni.getInstance()
                .rimuoviPrenotazione(prenotazione);

        evento.aumentaPosti();

        SistemaNotifiche notifiche = new SistemaNotifiche();
        notifiche.inviaAnnullamento(cliente, evento);

        return "Prenotazione annullata con successo.";
    }
}
