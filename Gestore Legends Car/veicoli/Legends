package it.unipv.bitFactory.veicoli;

import it.unipv.bitFactory.pezzi.Pezzo;
import it.unipv.bitFactory.pezzi.TipoPezzo;

import java.util.EnumMap;
import java.util.Map;

public class Legends extends Veicolo {
    private final Map<TipoPezzo, Pezzo> pezzi;

    public Legends() {
        this.pezzi = new EnumMap<>(TipoPezzo.class);
    }

    public void modificaPezzi(Pezzo pezzo) {
        pezzi.put(pezzo.getTipo(), pezzo);
    }

    public Pezzo getPezzo(TipoPezzo tipo) {
        return pezzi.get(tipo);
    }

    @Override
    public void percorriKm(int km) {
        super.percorriKm(km);

        for (Pezzo pezzo : pezzi.values()) {
            pezzo.aggiornaKm(km);
        }
    }
}
