package it.unipv.bitFactory.veicoli;
	
public abstract class Veicolo {
	private int kmTotali;
	
	  public Veicolo() {
	        this.kmTotali = 0;
	    }
	  
	//mettere caratteristiche generali, come i km, numero passeggeri, numero ruote
	  
	public void percorriKm(int km) {
        kmTotali += km;
    }
}
